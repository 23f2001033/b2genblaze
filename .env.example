# ---------------------------------------------------------------------------
# Backblaze B2  — https://secure.backblaze.com/app_keys.htm
# ---------------------------------------------------------------------------
# IMPORTANT: create the bucket with OBJECT LOCK ENABLED. It cannot be turned on
# afterwards, and the attestation layer depends on it. A PRIVATE bucket is
# correct (and free — B2 charges for public buckets); assets are delivered via
# short-lived presigned URLs minted by the API.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Must match your bucket's endpoint, e.g. s3.us-east-005.backblazeb2.com -> us-east-005.
# Set this explicitly: us-east-005 answers cross-region requests with 403 rather
# than a redirect, so the SDK cannot auto-correct it.
B2_REGION=us-east-005

# ---------------------------------------------------------------------------
# Featherless AI — planner + copy/policy judge   https://featherless.ai
# ---------------------------------------------------------------------------
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------------------------------------------------------------------------
# NVIDIA NIM — image generation + vision judge   https://build.nvidia.com (free)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
IMAGE_MODEL=black-forest-labs/flux.1-dev
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Google AI Studio — cross-provider fallback     https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs — voiceover                          https://elevenlabs.io
# Without this, the composed video ships silent.
ELEVENLABS_API_KEY=
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
# DEMO_MODE=1 uses Genblaze's MockProvider: real manifests, real B2 writes,
# real verification, zero provider spend.
DEMO_MODE=0
MAX_JUDGE_ITERATIONS=3
JUDGE_PASS_SCORE=0.75
ATTEST_RETENTION_DAYS=365
SIGNED_URL_TTL=3600
STEP_TIMEOUT=240
